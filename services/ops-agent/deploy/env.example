# /etc/ivrm-ops-agent/env   (chmod 600, owner root)
# Not committed with real values.

# How the approver is notified. Set EITHER the webhook OR the bot DM settings, never both.
#
# (Recommended) Webhook of a private channel only the approver can read. No bot is needed, and the
# URL can post to that channel and change or delete that webhook, but not touch the server. The URL
# contains a secret: keep it in this file only.
OPS_AGENT_DISCORD_WEBHOOK_URL=

# (Optional) Direct message through a dedicated bot application. Do not reuse the Herta bot token.
# The bot must share a server with the approver and the approver must allow DMs from server members.
OPS_AGENT_DISCORD_BOT_TOKEN=
OPS_AGENT_DISCORD_USER_ID=

# Optional overrides (defaults shown)
# OPS_AGENT_BEDROCK_REGION=ap-northeast-1
# OPS_AGENT_BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
# OPS_AGENT_MONTHLY_BUDGET_JPY=1500
# OPS_AGENT_WATCH_MIN_DURATION_SECONDS=300
# OPS_AGENT_WATCH_REPEAT_AFTER_SECONDS=3600
