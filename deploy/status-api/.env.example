# 32 bytes以上のランダム値を推奨。Gitへ本物の値をコミットしない。
HERTA_INGEST_SECRET=replace-with-random-secret

INGEST_MAX_BODY_BYTES=16384
INGEST_MAX_CLOCK_SKEW_SECONDS=120
INGEST_REPLAY_TTL_SECONDS=600
INGEST_RATE_LIMIT_PER_MINUTE=10
STATUS_HISTORY_RETENTION_DAYS=30
HERTA_STALE_AFTER_SECONDS=120
MINECRAFT_STALE_AFTER_SECONDS=300

# Status APIコンテナからOCIホストで公開されているMinecraftへServer List Pingを送る。
# 接続先はhost-gateway、ハンドシェイク上のホスト名はmc-router向けに公開名を使用する。
MINECRAFT_PROBE_CONNECT_HOST=host.docker.internal
MINECRAFT_PROBE_SERVER_ADDRESS=mc.ivrm.jp
MINECRAFT_PROBE_PORT=25565
MINECRAFT_PROBE_TIMEOUT_SECONDS=2
MINECRAFT_PROBE_CACHE_SECONDS=15

# 公開済みIncident / Maintenance / Announcementだけを取得するSanitized Feed。
# Supabase Service RoleやWebhook SecretはOCIへ配置しない。
STATUS_PUBLIC_CONTENT_FEED_URL=https://console.ivrm.jp/api/public/status-feed
STATUS_PUBLIC_CONTENT_CACHE_PATH=/data/public-status-content.json
STATUS_PUBLIC_CONTENT_TIMEOUT_SECONDS=1.5
STATUS_PUBLIC_CONTENT_REFRESH_SECONDS=30
STATUS_PUBLIC_CONTENT_STALE_SECONDS=600
